VITE_GOOGLE_MAPS_API_KEY=AIzaSy...TuApiKey...

# Gateway (docker compose microservicios → :8080). En desarrollo puedes omitirlo y usar el proxy de Vite.
# VITE_API_GATEWAY_URL=http://localhost:8080

# Opcional: URLs directas (mismo gateway por defecto). En microservicios los puertos son:
# IAM 8091, pets 8092, reports 8093, geo 8094, media 8095, matching 8096, capacity 8097, audit 8098, BFF 8081
# VITE_API_USUARIOS_URL=http://localhost:8080
# VITE_API_MASCOTAS_URL=http://localhost:8080
# VITE_API_REPORTES_URL=http://localhost:8080
